# Copy to .env and fill in. Loaded by docker-compose.

# --- Postgres ---
POSTGRES_USER=bliss
POSTGRES_PASSWORD=bliss_dev
POSTGRES_DB=bliss

# --- Backend (read by config.yml via ${VAR:-default} substitution) ---
# JWT signing key. Must be at least 32 chars in dev. Generate a real value for staging/prod.
# The backend refuses to boot if BLISS_ENV=production and this is still the default below.
BLISS_JWT_SECRET=dev-secret-change-me-dev-secret-change-me
# Sentry DSN. Leave blank in local dev to disable.
BLISS_SENTRY_DSN=
# Environment label (development, staging, production)
BLISS_ENV=development

# Base URLs for the two frontend surfaces. Local dev serves both from the one
# Next dev server; prod splits them across hostnames:
#   BLISS_MERCHANT_BASE_URL=https://property.bliss-payments.com
#   BLISS_CONSUMER_BASE_URL=https://guest.bliss-payments.com
BLISS_MERCHANT_BASE_URL=http://localhost:3000
BLISS_CONSUMER_BASE_URL=http://localhost:3000

# Session cookie scope. Local dev is same-origin, so Lax + host-only works.
# Prod puts the frontend and API on different subdomains, which needs:
#   BLISS_COOKIE_SAMESITE=None
#   BLISS_COOKIE_DOMAIN=.bliss-payments.com
BLISS_COOKIE_SAMESITE=Lax
BLISS_COOKIE_DOMAIN=

# Transactional email. Blank token logs the message instead of sending it.
BLISS_POSTMARK_TOKEN=
BLISS_EMAIL_FROM=no-reply@bliss.com

# --- Frontend ---
# Public URL of the backend, called from server components and client.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Sentry DSN for the frontend. Leave blank to disable.
NEXT_PUBLIC_SENTRY_DSN=
