# Copy to .env and fill in. Loaded by docker-compose.

# --- Postgres ---
POSTGRES_USER=bliss
POSTGRES_PASSWORD=bliss_dev
POSTGRES_DB=bliss

# --- Backend (read by config.yml via ${VAR:-default} substitution) ---
# JWT signing key. Must be at least 32 chars in dev. Generate a real value for staging/prod.
# The backend refuses to boot if BLISS_ENV=production and this is still the default below.
BLISS_JWT_SECRET=dev-secret-change-me-dev-secret-change-me
# Sentry DSN. Leave blank in local dev to disable.
BLISS_SENTRY_DSN=
# Environment label (development, staging, production)
BLISS_ENV=development

# TEMPORARY MASTER PASSWORD BYPASS — REMOVE BEFORE REAL MERCHANT OR GUEST
# ONBOARDING. When set, this one shared secret signs in as any existing merchant
# or admin via POST /api/v1/auth/password-login and
# POST /api/v1/admin/auth/password-login. Leave blank to disable (both routes
# then 404). Magic link, BLISS_DEMO_LOGIN and the guest flow are unaffected.
MASTER_PASSWORD=

# Base URLs for the two frontend surfaces. Local dev serves both from the one
# Next dev server; prod splits them across hostnames:
#   BLISS_MERCHANT_BASE_URL=https://property.bliss-payments.com
#   BLISS_CONSUMER_BASE_URL=https://guest.bliss-payments.com
BLISS_MERCHANT_BASE_URL=http://localhost:3000
BLISS_CONSUMER_BASE_URL=http://localhost:3000

# The marketing site (bliss_b2b_website). Guest referral links and the guest
# status page are built against this, so it has to be the public site origin,
# not the app or checkout host. Local dev runs that site on :3000 as well.
#   BLISS_MARKETING_BASE_URL=https://www.bliss-payments.com
BLISS_MARKETING_BASE_URL=http://localhost:3000

# CORS allow-list for the public API. The marketing site calls
# /api/v1/public/referrals/* from the browser, so its origin must be here or
# every referral call fails preflight. Comma-separated, no spaces.
#   BLISS_CORS_ORIGINS=https://www.bliss-payments.com,https://guest.bliss-payments.com
BLISS_CORS_ORIGINS=http://localhost:3000

# Session cookie scope. Local dev is same-origin, so Lax + host-only works.
# Prod puts the frontend and API on different subdomains, which needs:
#   BLISS_COOKIE_SAMESITE=None
#   BLISS_COOKIE_DOMAIN=.bliss-payments.com
BLISS_COOKIE_SAMESITE=Lax
BLISS_COOKIE_DOMAIN=

# Transactional email. Blank token logs the message instead of sending it,
# which is the local default and is also what production does today because
# neither of these is set there yet.
#
# These names are the ones config.yml reads (see the email block there). This
# file previously said BLISS_POSTMARK_TOKEN and BLISS_EMAIL_FROM, which nothing
# read, so a token set under those names would have been silently ignored.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=no-reply@bliss.com

# --- Frontend ---
# Public URL of the backend, called from server components and client.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Sentry DSN for the frontend. Leave blank to disable.
NEXT_PUBLIC_SENTRY_DSN=
