# Frontend env vars. Copy to .env.local for local dev.
# In prod (Vercel) this is the API origin: https://api.bliss-payments.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_ENV=development
# Shows the "Use demo credentials" button on the Mews connect step. Dev and
# demo builds only; leave unset in production.
NEXT_PUBLIC_MEWS_DEMO_FILL=true
